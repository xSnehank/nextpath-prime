# PRISM Engine environment variables. Never commit real values.
#
# Neither app reads a .env at the repo root. Copy each block into the file that app loads:
#   frontend -> frontend/.env.local   (Next.js only loads env files from frontend/)
#   backend  -> backend/.env          (full list with comments: backend/.env.example)

# ---- frontend/.env.local ----
# The browser can only read variables that start with NEXT_PUBLIC_, and everything with
# that prefix ends up in the public JavaScript bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000
# true while the backend runs with USE_MOCKS=true (lets the app act as the demo student or parent)
NEXT_PUBLIC_USE_MOCKS=true
# Supabase project URL and anon (public) key, from your Supabase project (Project Settings -> API).
# Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- backend/.env ----
# Postgres connection string: local, or Supabase's pooler URL when hosted.
DATABASE_URL=
