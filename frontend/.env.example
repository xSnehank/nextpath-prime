# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# Enable mock mode to bypass Supabase and test against mock backend responses
NEXT_PUBLIC_USE_MOCKS=true
# Supabase project URL (optional in mock mode)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous public API key (optional in mock mode)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
