# Copy to backend/.env for local development. Never commit .env.

ENVIRONMENT=development
# true = every endpoint answers from app/mocks/*.json; no database needed
USE_MOCKS=true
DATABASE_URL=
SUPABASE_JWT_SECRET=
GEMINI_API_KEY=
# Check Google AI Studio for the current free-tier model name
GEMINI_MODEL=
# gemini | template (template = never call Gemini)
EXPLAIN_MODE=template
# Accept an X-Dev-User header instead of a real token; refused when ENVIRONMENT=production
DEV_AUTH_BYPASS=false
DEMO_ENABLED=true
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
