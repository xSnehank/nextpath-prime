# Copy to backend/.env for local development. Never commit .env.

ENVIRONMENT=development
# true = every endpoint answers from app/mocks/*.json; no database needed
USE_MOCKS=true
# Live mode (USE_MOCKS=false) needs the next three.
# Supabase dashboard -> Connect -> Session pooler (port 5432). Contains the database password: never commit it.
DATABASE_URL=
# Supabase dashboard -> Project Settings -> API: the project URL and the anon / publishable key (public).
SUPABASE_URL=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# Check Google AI Studio for the current free-tier model name
GEMINI_MODEL=
# gemini | template (template = never call Gemini)
EXPLAIN_MODE=template
# Accept an X-Dev-User header instead of a real token; refused when ENVIRONMENT=production
DEV_AUTH_BYPASS=false
# POST /demo/run and the public demo-family result. Off: the app has no Live Demo.
DEMO_ENABLED=false
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
